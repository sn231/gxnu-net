; 广西师范大学（GXNU）校园网自动登录 - 配置模板
; 使用说明：复制本文件为 config.ini，然后填入你的学号和密码。
; config.ini 已在 .gitignore 中排除，不会被提交到 Git。

[account]
; 学号（校园网上网账号）
username = 你的学号
; 密码（明文填写，en_md5=0 时直接提交；脚本不会把密码写入日志）
password = 你的密码

; 运营商 / 出口线路，对应表单里的 R3 字段
;   0 = 校园网（默认，走学校出口）
;   1 = 中国电信
;   2 = 中国联通
;   3 = 中国移动
;   4 = 校园网(专)
isp = 0

[network]
; 认证门户域名（一般不用改）
host = yc.gxnu.edu.cn
; 是否使用 https
https = true

; 联网检测地址（用于判断掉线）。门户会把常见检测域名列入黑名单，
; 因此这里直接请求门户自身的状态接口来判定，最准。
; 额外可选的外网检测地址，逗号分隔，留空则只靠门户状态判断
probe_urls = https://www.baidu.com,https://www.qq.com

[daemon]
; 后台守护模式的检测间隔（秒）
interval = 30
; 单次请求超时（秒）
timeout = 8
; 连续多少次检测失败后才重新登录
fail_threshold = 2
; 第一次判定离线后隔多少秒复查（确认不是网络抖动）
recheck_delay = 10

[log]
; 日志文件路径（相对脚本目录，留空则不写文件）
file = gxnu-net.log
; 日志级别 DEBUG / INFO / WARNING / ERROR
level = INFO
; 单个日志文件的最大字节数，超过则轮转
max_bytes = 1048576
; 保留的日志轮转文件个数
backup_count = 3
